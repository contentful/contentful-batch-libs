{
  "name": "contentful-batch-libs",
  "version": "0.0.0-determined-by-semantic-release",
  "description": "Library modules used by contentful batch utility CLI tools.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsup",
    "build:watch": "tsup --watch",
    "clean": "rimraf dist && rimraf coverage",
    "lint": "eslint lib test/* test",
    "test": "jest",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand --watch",
    "test:watch": "npm run test -- --watch",
    "semantic-release": "semantic-release"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "figures": "^6.1.0",
    "https-proxy-agent": "^9.1.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@types/jest": "^29.5.6",
    "@types/node": "^26.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "contentful": "^11.12.1",
    "contentful-management": "^12.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.51.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-promise": "^6.1.1",
    "husky": "9.1.7",
    "jest": "^30.0.0",
    "listr2": "^11.0.1",
    "rimraf": "^6.0.0",
    "semantic-release": "^25.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2"
  },
  "files": [
    "dist",
    "test"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/contentful/contentful-batch-libs.git"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [
    "contentful",
    "batch"
  ],
  "author": "Contentful <opensource@contentful.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/contentful/contentful-batch-libs/issues"
  },
  "homepage": "https://github.com/contentful/contentful-batch-libs#readme",
  "release": {
    "branches": [
      "master",
      {
        "name": "beta",
        "channel": "beta",
        "prerelease": true
      }
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "releaseRules": [
            {
              "breaking": true,
              "release": "major"
            },
            {
              "type": "build",
              "scope": "deps",
              "release": "patch"
            }
          ]
        }
      ],
      "@semantic-release/release-notes-generator",
      "@semantic-release/changelog",
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}